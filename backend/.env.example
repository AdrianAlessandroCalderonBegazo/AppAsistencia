# Cadena de conexión de Postgres. Cambiar de Supabase/Neon (plan gratis) a Render/plan pago,
# o entre proveedores, es solo cambiar esta variable — el código no referencia el proveedor.
DATABASE_URL=postgres://user:password@localhost:5432/fronticr

PORT=3000

# CORS: dominio(s) del frontend permitido(s), separados por coma. Usar "*" solo en desarrollo.
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# Regla de contraseña genérica asignada al crear un empleado o al resetear su clave:
# primeros 4 dígitos del DNI + "Icr" (ej. DNI 12345678 -> "1234Icr").
# Ver backend/src/utils/genericPassword.js si se necesita cambiar la regla.
GENERIC_PASSWORD_RULE=first4digits+Icr

# Firebase Admin SDK (Firebase Cloud Messaging) — opcionales en desarrollo.
# Si se omiten, backend/src/services/notifications.js no falla: solo registra en consola (no-op).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Si la clave privada viene de un .env plano, reemplazar saltos de línea reales por "\n".
FIREBASE_PRIVATE_KEY=

# Poner en "true" para desactivar el cron de recordatorios (útil en tests o en desarrollo).
DISABLE_REMINDERS_CRON=false
